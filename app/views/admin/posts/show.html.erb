
<p style="color: green"><%= notice %></p>

<h1>Post Details</h1>

<div>
  <p>
    <strong>Title:</strong>
    <%= @post.title %>
  </p>

  <p>
    <strong>Content:</strong>
    <%= @post.content %>
  </p>

  <p>
    <strong>Tags:</strong>
    <% if @post.tags.any? %>
      <% @post.tags.each do |tag| %>
        <span><%= tag.name %></span>
      <% end %>
    <% else %>
      No tags added
    <% end %>
  </p>
</div>

<div>
  <%= link_to "Edit this post", edit_admin_post_path(@post) %> |
  <%= link_to "Back to posts", admin_posts_path %>
</div>
