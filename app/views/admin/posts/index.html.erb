
<p style="color: green"><%= notice %></p>

<h1>Posts</h1>

<div id="posts">
  <% @posts.each do |post| %>
    <%= render post %>

    <p>
      <strong>Tags:</strong>
      <% if post.tags.any? %>
        <% post.tags.each do |tag| %>
          <span><%= tag.name %></span>
        <% end %>
      <% else %>
        No tags added
      <% end %>
    </p>

    <p>
      <%= link_to "Show this post", admin_post_path(post) %>
    </p>
  <% end %>
</div>

<%= link_to "New post", new_admin_post_path %>
<%= button_to "Sign Out", destroy_admin_session_path, method: :delete %>
