
<div id="<%= dom_id post %>">
  <p>
    <strong>Title:</strong>
    <%= post.title %>
  </p>

  <p>
    <strong>Content:</strong>
    <%= post.content %>
  </p>

  <p>
    <strong>Tags:</strong>
    <% if post.tags.any? %>
      <% post.tags.each do |tag| %>
        <span><%= tag.name %></span>
      <% end %>
    <% else %>
      No tags added
    <% end %>
  </p>
</div>
